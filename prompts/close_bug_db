#!/usr/bin/env python3
"""Assess closure through Koine, with Anoieu's baselines and evidence rules.

Projects and refs come from reporting/config/deps.json; baselines come from
open findings' found_at, falling back to deps.lock. --use-local accepts paths
or names from repos.local. Koine supplies the windows, assessment procedure,
assistant launcher and database preservation check. Nothing here fetches: the
checkout selected through $KOINE, ../koine or deps/koine must already contain
koine_close_db, koine_window and koine_check_db.

    prompts/close_bug_db --dry-run
    prompts/close_bug_db cvc5 ethos --show-prompt
    prompts/close_bug_db --use-local ethos=/src/ethos
"""
import argparse
import json
import os
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

from anoieu_analyzer.reporting import CONFIG_DIR, koine, verdicts  # noqa: E402

DEPS = os.path.join(CONFIG_DIR, "deps.json")
LOCK = os.path.join(CONFIG_DIR, "deps.lock")
DB = os.path.join(ROOT, "bug_db", "bugs.json")
EXPERIENCE = os.path.join(ROOT, "docs", "experience.md")
SCRIPT = os.path.abspath(__file__)

ABOUT = """Anoieu is a static analyzer and differential fuzzer for Eunoia signatures.
Read `bug_db/README.md` for what an observation is and what closes one, and
`anoieu_analyzer/checks.md` for what each code claims."""

EVIDENCE = """**Two kinds of row need different evidence, and the code says which.**

- `EO`, `DOC` and `TRI` rows are claims about a file, confirmed by reading that
  file as the project ships it. That is the work above.
- `FUZ` rows are claims about a *program's behaviour*, and this run cannot close
  one. Closure there takes a replay -- `python3 -m anoieu_fuzz replay
  tests/fuzz/<bucket>/case.eo` against a build of the checker -- which is a
  separate pass with its own binary, and reading a commit is not a substitute.
  If a commit looks like it fixed one, say so as a **candidate for replay**
  in your report, name the commit, and leave the row open. A fix like that
  still belongs in `docs/experience.md` (see (b) below): the row is open, but
  the maintainer's work happened, and the log records it now.
- A row owned by two projects, written `a+b`, is a disagreement *between* them.
  Either side's change can resolve it. Say which project's commit did, record
  that project as `closed_by` when you close it, and re-read both sides before
  you call it closed.

Name any `FUZ` candidates for replay in the final report, with their commits."""

WRITES = """(a) **The closure, on the entry.** Close every observation whose claim you
    have re-read as false in the source today. Being cautious is right when you
    are unsure, but a row you confirmed and left open is also a mistake: the
    open reports and the tally keep counting it against a project that fixed it.
    For each observation you closed, add these fields to its object in
    `bug_db/bugs.json` and change nothing else about it:

      "closed_verdict"  one of the seven words below
      "closed_why"      why the claim no longer holds, and what you re-read to
                        establish it -- the file and the line as the project
                        ships them today, not what the commit message said
      "closed_on"       "{when}"
      "closed_commit"   the full sha it closed on
      "closed_pr"       the pull request, where there is one
      "closed_by"       for a row owned by two projects (`a+b`) only: the one
                        project whose change closed it. A disagreement counts
                        as a bug of exactly one side, and the tally in
                        `docs/experience.md` charges it to this project

    One change often closes several observations. Give each of them the same
    `closed_commit`, and claim all of them in a single experience entry.

    **A verdict is one of seven words**, and two of them can apply here:

      `fixed and landed`   -- the change is on that project's default branch.
                              Name what landed it, and add no `awaiting_landing`.
      `accepted and fixed` -- the change is a commit on a named branch that is
                              **not** the branch above. It owes

                                "awaiting_landing": {"project": ..., "branch": ...,
                                                     "commit": ...}

                              which `python3 -m anoieu_analyzer.reporting.verdicts
                              --check` reads back later and asks the project
                              about. Every ref this run reads is a project's
                              default branch, so the ordinary outcome here is
                              `fixed and landed`; this one is for a fix you found
                              on a topic branch or in an unmerged pull request,
                              where the debt has to stay checkable.

    The others are verdicts about an observation's *merits* and are not yours to
    record from a commit:

      {theirs}

    The vocabulary and its reason are in *Closure* in `bug_db/README.md`;
    `verdicts.py` holds the copy that runs and `tests/run.py` compares the two,
    so a verdict worded past the list leaves the vocabulary rather than leaving
    the audit.

    **Add no entry and remove none.** koine is the only thing that creates an
    entry here, and an observation you could not close keeps its entry exactly as
    it stands. Entries already carrying a ruling are nobody's question now.
    Leave `tests/fuzz/` alone as well -- a
    promoted reproducer is evidence, not a status -- and edit no generated page
    by hand: `bug_db/bugs.md`, `bug_db/static-analysis.md` and `anoieu_analyzer/checks.md`
    come from their generators, and so does the tally in `docs/experience.md`.
    Re-render the open reports and the tally once you are done:
    `python3 -m anoieu_analyzer.reporting.database`, then run
    `python3 -m anoieu_analyzer.reporting.database --check`.
    Every entry carrying a `closed_verdict` must disappear from `bugs.md` and
    `static-analysis.md`, including declined and intentional (won't fix) entries.
    Keep the entries and landing debt in `bugs.json`; leave the regenerated
    reports with the closure edits for review.

(b) **The log. It is half of this job, not an afterthought to (a).**
    `docs/experience.md` is a log of **episodes**, oldest first, numbered
    `E<n>`. An episode is something that passed between this repository and a
    project it reports on, and the bar is that **a maintainer of that project
    spent attention on it** -- they merged, rejected or acted on something of
    ours, or put a correction to us.

    **An entry is decided by what the maintainer did, not by what you could
    close.** Go through every window for changes that answer us. Look for
    commits and pull requests that cite anoieu, that add a regression test built
    from one of our reproducers, or that touch exactly what an open row names.
    Each of those is an episode, and it gets its entry in this run. That holds
    even when nothing closes: a fuzzer fix that needs a replay is the ordinary
    case. The entry's outcome then says what is still owed, for example *"open: FUZ rows X
    and Y are candidates for replay"*, and whichever pass closes them later
    writes a new entry naming this one by id. Before you write, check whether an
    existing entry already covers the change: an episode is recorded once.

    What earns **no** entry: a window in which nobody there did anything with
    what we sent, and a mistake of ours that nobody there saw. Those go to
    `docs/history.md` or nowhere, as below.

    **The page also has a running tally**: for each project, the bugs that
    have been closed against it and how they were closed. A disagreement is
    charged to its `closed_by` side, and open rows are not counted. It sits between the `tally:begin` and `tally:end` markers,
    and `python3 -m anoieu_analyzer.reporting.database` generates it along with
    the open reports. Never edit it by hand. Re-rendering after your closures is
    what updates it, and `--check` fails while it is stale.

    Use the shape that file sets out under *How this page is maintained* --
    `When`, `Kind`, `Ours`, `Theirs` and `Outcome` in the table, then
    `What happened`, then `Not closed` where there is something to put in it,
    then `What we learned`. `tests/run.py` compares that field list with this
    prompt, so changing one means changing both.

    **One entry per episode, not per observation and not per window.** A change
    that closed twenty-five rows is one entry naming all of them. The next id is
    one above the highest ever used, ids are never reused, and an entry is never
    rewritten to say something else -- a later entry corrects it by id.

    **Link every commit and pull request to the project it belongs to**, taking
    the remote from `anoieu_analyzer/reporting/config/deps.json`. A commit's link
    text is its short sha and its target is the remote followed by `/commit/`
    and the full sha; a pull
    request's link text is `#` and the number, and its target is the remote
    followed by `/pull/` and the number. A reader checking a claim here against
    the diff should not need a checkout.

    `What happened` is written for somebody who works on neither project: no
    check codes in the first sentence, and enough of the mechanism that a reader
    could go and check it. `Not closed` names any observation the change was
    expected to close and did not, with what was re-read to establish that --
    the field exists because a change that closes eleven rows and quietly leaves
    a twelfth reads as complete. `What we learned` is the field that makes this a
    post-mortem rather than a changelog, and the one a thin window drops first.

    Record whether the change cites us in `Kind` or `Outcome`, and do not argue
    for it -- attribution is secondary, and a fix a project found on its own
    still closed an observation of ours and is still evidence the check was
    pointing at something real.

    **Anything a window taught you about *our* tooling** goes under *What a run
    learned about itself* in `docs/history.md` instead -- a stale baseline, a
    check that failed open, a rename that will read as a disappearance. One line
    each, newest first, and an empty section is the honest result when a run
    turned up nothing about us."""


def projects():
    """What the analyzer is pointed at, with the ref each finding is about.

    From `config/deps.json`, because a ref is a choice that file records rather
    than a flag, and a window read against the wrong branch answers about a tree
    nobody ships. Every ref there is `main` as of 2026-09-19 -- the ethos
    exception on `ethosEoc3` is gone -- but this reads the file rather than
    assuming that, because the next exception is a line in it and not a release.
    """
    with open(DEPS) as f:
        data = json.load(f)
    return {name: entry for name, entry in data.items() if not name.startswith("_")}


def pinned():
    """The commits `deps.lock` records, as a last-resort baseline."""
    with open(LOCK) as f:
        return {n: e["commit"] for n, e in json.load(f).items() if not n.startswith("_")}


def database():
    """Every observation by id. The claims themselves stay in the file."""
    with open(DB) as f:
        return {b["id"]: b for b in json.load(f)["bugs"]}


def open_rows():
    """Every observation still open, from the database.

    One record, so one reading. An entry carrying closure fields has been
    ruled on and is skipped; everything else is a claim somebody could still
    falsify. `found_at` is the revision the claim was recorded against, which is
    the whole baseline question -- an entry that carries none is listed with no
    baseline of its own rather than quietly given somebody else's.
    """
    return [b for b in database().values()
            if not any(k.startswith("closed_") or k == "awaiting_landing" for k in b)]


def by_project(rows, known):
    """One project's rows, for each project -- and a compound owner is in both.

    `ethos+logos` is a triple finding: a disagreement *between* two projects,
    which either of them can have resolved. Filing it under a single owner would
    put it in one window and leave the other blind to it.
    """
    out = {name: [] for name in known}
    for row in rows:
        for name in row["owner"].split("+"):
            if name in out:
                out[name].append(row)
            else:
                raise ValueError(f"{row['id']} is owned by {name!r}, which "
                                 f"config/deps.json does not name")
    return out


def baseline(name, rows, explicit, locks, root=""):
    """The revision this project's open rows were recorded against.

    The rows themselves say so, in `found_at`, and usually they agree. When they
    do not, the honest baseline is the *oldest* of them -- a window that starts
    later skips the commits an earlier row is about -- and ordering two short
    shas needs a history, so it is done when a checkout was named and declined
    otherwise. `deps.lock` is the fallback and not the default: it pins what a
    reproducible run measures, which is a different question and routinely older.
    """
    if explicit:
        return explicit, "--since"
    revs = sorted({r["found_at"] for r in rows if r.get("found_at")})
    silent = sum(1 for r in rows if not r.get("found_at"))
    unrecorded = (f"; {silent} row(s) record no revision and may predate it"
                  if silent else "")
    if len(revs) == 1:
        n = sum(1 for r in rows if r.get("found_at") == revs[0])
        return revs[0], f"the {n} open row(s) recorded at it{unrecorded}"
    if len(revs) > 1:
        if root:
            for oldest in revs:
                if all(subprocess.run(
                        ["git", "-C", root, "merge-base", "--is-ancestor", oldest, rev],
                        capture_output=True).returncode == 0 for rev in revs):
                    return oldest, (f"the oldest of {len(revs)} recorded revisions, "
                                    f"per {root}{unrecorded}")
        raise ValueError(
            f"{name}'s open rows were recorded against {len(revs)} revisions "
            f"({', '.join(revs)}) and no oldest revision could be established: give "
            f"--since {name}=<rev>, or name a full checkout with --use-local")
    return locks[name], "config/deps.lock; no open row records a revision"  # noqa: E501


def pairs(values, known, flag):
    """`--use-local ethos=/src/ethos` and friends, checked against deps.json."""
    out = {}
    for value in values or []:
        name, _, rest = value.partition("=")
        if name not in known:
            raise ValueError(f"{flag} names {name!r}, which config/deps.json does not: "
                             f"{', '.join(known)}")
        out[name] = os.path.expanduser(rest.strip())
    return out


def main(argv=None):
    ap = argparse.ArgumentParser(
        description="Assess what each watched project has done about our open findings.")
    ap.add_argument("project", nargs="*", help="a project from config/deps.json; "
                                              "omitted, every one of them")
    ap.add_argument("--use-local", nargs="*", metavar="NAME[=PATH]",
                    help="read local checkouts instead of github: NAME=PATH, or a bare "
                         "NAME (or no value at all) for what config/repos.local says")
    ap.add_argument("--since", action="append", metavar="NAME=REV",
                    help="baseline for one project; default: the revision its open rows "
                         "were recorded at")
    ap.add_argument("--date", help="the date to record; default: today")
    ap.add_argument("--dry-run", action="store_true", help="print the scope and exit")
    ap.add_argument("--show-prompt", action="store_true",
                    help="print the prompt and exit, starting nothing")
    ap.add_argument("--codex", action="store_true", help="run codex instead of claude")
    ap.add_argument("--print", action="store_true", dest="noninteractive",
                    help="run non-interactively and print the result")
    ap.add_argument("--section", choices=("about", "evidence", "writes"),
                    help=argparse.SUPPRESS)
    ap.add_argument("--baselines", action="store_true", help=argparse.SUPPRESS)
    argv = list(sys.argv[1:] if argv is None else argv)
    args = ap.parse_args(argv)
    if args.section:
        theirs = ", ".join(f"`{w}`" for w in verdicts.OUTCOMES
                           if w not in ("fixed and landed", "accepted and fixed")) + "."
        print({"about": ABOUT, "evidence": EVIDENCE,
               "writes": WRITES.replace("{theirs}", theirs)}[args.section])
        return 0
    try:
        known = projects()
        unknown = set(args.project) - set(known)
        if unknown:
            raise ValueError(f"not a project in config/deps.json: {', '.join(sorted(unknown))}")
        wanted = [n for n in known if not args.project or n in args.project]
        rows = by_project(open_rows(), known)
        since, locks = pairs(args.since, known, "--since"), pinned()
        local = {}
        if args.use_local is not None:
            given = pairs([v for v in args.use_local if "=" in v], known, "--use-local")
            configured = verdicts._checkouts([])
            named = [v for v in args.use_local if "=" not in v] or ([] if given else wanted)
            for name in list(given) + [n for n in named if n not in given]:
                if name not in known:
                    raise ValueError(f"unknown project in --use-local: {name}")
                path = given.get(name) or configured.get(name, "")
                via = "--use-local" if name in given else "config/repos.local"
                if not path:
                    raise ValueError(f"config/repos.local names no {name} checkout; "
                                     f"give --use-local {name}=<path>")
                if not os.path.isdir(path):
                    raise ValueError(f"no {name} checkout at {path} (from {via})")
                local[name] = (os.path.abspath(path), via)

        busy = [n for n in wanted if rows[n]]
        if args.baselines:
            for name in busy:
                rev, why = baseline(name, rows[name], since.get(name), locks,
                                    local.get(name, ("", ""))[0])
                print(name, rev, why)
            return 0

        tool = koine.find(clone=False, programs=("koine_close_db", "koine_window", "koine_check_db"))
        # Koine describes empty windows; Anoieu declines to start an assessment
        # when every requested window is local and empty, as before.
        if busy and all(n in local for n in busy) and not args.dry_run:
            windows = []
            for name in busy:
                rev, _ = baseline(name, rows[name], since.get(name), locks, local[name][0])
                result = subprocess.run(
                    [sys.executable, koine.script_in(tool, "koine_window"),
                     "--baseline", rev, "--local", local[name][0], "--json"],
                    capture_output=True, text=True)
                if result.returncode:
                    raise ValueError(result.stderr.strip())
                windows.append((name, json.loads(result.stdout)))
            if all(w["count"] == 0 for _, w in windows):
                for name, w in windows:
                    print(f"-- {name}: no commit after the baseline in {w['root']}", file=sys.stderr)
                    for ref in w["elsewhere"]:
                        print(f"--   {ref['ref']} is {ref['ahead']} commit(s) ahead of HEAD", file=sys.stderr)
                return 0

        cfg = {
            "root": ROOT, "tool": "anoieu", "database": DB, "projects": known,
            "records": {"one": "observation", "many": "observations",
                        "collective": "bug database"},
            "group": "code", "also": ["awaiting_landing"],
            "remeasure": "python3 scripts/run.py",
            "prompt": {name: {"command": [sys.executable, SCRIPT, "--section", name]}
                       for name in ("about", "evidence", "writes")},
            "checks": ["python3 -m anoieu_analyzer.reporting.verdicts",
                       "python3 -m anoieu_analyzer.reporting.database --check",
                       "python3 tests/run.py"],
        }
        forwarded = list(wanted)
        if local:
            forwarded += ["--use-local", *(f"{n}={p}" for n, (p, _) in local.items())]
        for value in args.since or []:
            forwarded += ["--since", value]
        if args.date:
            forwarded += ["--date", args.date]
        forwarded += [flag for flag, enabled in (
            ("--dry-run", args.dry_run), ("--show-prompt", args.show_prompt),
            ("--codex", args.codex), ("--print", args.noninteractive)) if enabled]
        cfg["baseline"] = {"command": [sys.executable, SCRIPT, "--baselines", *forwarded]}
        if not args.dry_run and not args.show_prompt and busy and not os.path.isfile(EXPERIENCE):
            raise ValueError("docs/experience.md is missing; it defines the episode format")
        with tempfile.TemporaryDirectory(prefix="anoieu-closure-") as directory:
            config = os.path.join(directory, "closure.json")
            with open(config, "w", encoding="utf-8") as fh:
                json.dump(cfg, fh)
            return subprocess.run(
                [sys.executable, koine.script_in(tool, "koine_close_db"),
                 "--config", config, *forwarded], cwd=ROOT).returncode
    except (OSError, ValueError, KeyError) as exc:
        print(f"close_bug_db: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
