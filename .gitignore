__pycache__/
*.pyc
.venv/

# the sources a report is generated from: a cache, rebuilt by anoieu/reporting/deps.py
deps/

# what a fuzzing run finds: reproducers, kept until somebody triages them
fuzz-findings/

# where each project is checked out on this machine, written by
# scripts/process_anoieu on first run
config/repos.local

# editor scratch
*.swp
*.swo

# transient working space (shared policy: "Working space is untracked")
scratch/

# Koine's runtime database lock; the database itself is tracked.
/bug_db/*.lock

# private working notes, untracked by intent
*.local.md
