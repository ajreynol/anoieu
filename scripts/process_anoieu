#!/usr/bin/env bash
# process_anoieu -- read a project's reply to anoieu's findings, from inside anoieu.
#
# The other half of check_anoieu. That one runs in ethos or logos and leaves a
# draft reply there; this one runs here, reads that reply, works out what
# actually happened, and updates the record.
#
#   process_anoieu logos                    # every reply in that repository
#   process_anoieu ethos 147433b3e48ae9d6   # one finding, by its id
#   process_anoieu --codex ~/src/cvc5       # ... with codex, and an explicit path
#   process_anoieu --no-postm logos         # ... without requiring a postmortem entry
#   process_anoieu --status logos           # what became of the branch; no agent
#   process_anoieu --dry-run logos          # what this would do; no agent
#
# The first argument is a *synonym* for a directory. It is resolved in three
# steps: an existing path is used as it stands; otherwise scripts/repos.local is
# consulted, which maps repo ids to directories on this machine and is written
# on the first run of any kind; otherwise a directory of that name is looked for under
# $ANOIEU_REPOS (colon-separated, default $HOME). Nothing is tracked or synced
# -- the agent is pointed at the directory and finds the reply itself.
#
# The canonical prompt is docs/reporting-policy.md, under "Prompt two: the
# follow-up, here"; that one is written around a link, this one around a
# checkout. If they disagree about anything else, the document is right.
#
# It prints the resolved path, so a pasted transcript carries it.

set -euo pipefail

# -- the mapping file: repo ids to directories on this machine. Written on the
#    first run of any kind, never tracked, and entirely optional -- the scan
#    further down still works for a project whose checkout is simply
#    $HOME/<name>. It exists for the ones that are not: a repository under a
#    different name, or several checkouts of one project where only one is the
#    one you answer findings from.
HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
REPOS_FILE="${ANOIEU_REPOS_FILE:-$HERE/repos.local}"

write_repos_file() {
  cat > "$REPOS_FILE" <<'TEMPLATE'
# process_anoieu -- where each project is checked out on this machine.
#
# One entry per line:
#
#     <repo-id> <path>
#
# <repo-id> is what you type as the first argument to process_anoieu, and
# <path> is the directory it means. A leading ~ is expanded, and a path may
# contain spaces. A line whose first non-blank character is # is a comment,
# blank lines are ignored, and the first entry for an id wins.
#
# This file is local to this machine and is not tracked by git. It is also
# optional: an id with no entry here is resolved by looking for a directory of
# that name under $ANOIEU_REPOS (default $HOME), and a path given on the command
# line is used as it stands. What the file is for is the cases where neither
# works -- a checkout under a different name, or several checkouts of one
# project where only one of them is the one you answer findings from.
#
# The projects tools/deps.json tracks, as examples. Uncomment and correct:
#
#     ethos       ~/src/ethos
#     logos       ~/src/logos
#     cvc5        ~/src/cvc5
#     eudaimonia  ~/src/eudaimonia
TEMPLATE
}

# How many entries it has, which is what "set up" means. A file that exists and
# says nothing is the same situation as no file at all, and was the bug this
# replaced: the notice fired on creation, so a file created once and never
# filled in went quiet while still being empty.
repos_entries() {
  local n
  n=$(grep -cvE '^[[:space:]]*(#|$)' "$REPOS_FILE" 2>/dev/null) || n=0
  printf '%s\n' "$n"
}

announce_repos_file() {
  cat >&2 <<BANNER

======================================================================
  $1

      $REPOS_FILE

  It maps repo ids to directories on this machine -- nothing else
  knows where your checkouts are, and the file is not tracked by git.
  Open it now and add a line per project:

      <repo-id> <path>

  Until you do, an id is only resolved by looking for a directory of
  that name -- which finds a checkout called "logos" and nothing
  called anything else -- under
      ${ANOIEU_REPOS:-\$HOME}

  This notice stops as soon as the file has one entry.
======================================================================

BANNER
}

# Both checked before anything else is decided, including whether the arguments
# were any good: a run that stops at the usage message is still a run where
# somebody needs to be told about the file.
if [ ! -e "$REPOS_FILE" ]; then
  write_repos_file
  announce_repos_file "process_anoieu has just created its configuration file. Set it up."
elif [ "$(repos_entries)" -eq 0 ]; then
  announce_repos_file "process_anoieu's configuration file has no entries yet. Set it up."
fi

AGENT=claude
PRINT=0
SHOW=0
DRY=0
STATUS=0
CHECK=1
POSTM=1
BRANCH=""
NAME=""
ID=""

usage() {

  cat >&2 <<'USAGE'
usage: process_anoieu [--status | --dry-run | --show-prompt]
                     [--codex] [--print] [--no-postm] [--branch NAME] NAME [ID]

  NAME            a directory, or a repo id: looked up in scripts/repos.local
                  (written on the first run), then under $ANOIEU_REPOS (default $HOME)
  ID              an anoieu finding id (16 hex digits) or register id (ethos-8).
                  Omitted, every reply in that repository is processed.
  --codex         run codex instead of claude
  --branch NAME   the branch check_anoieu worked on (default: anoieu-findings,
                  or anoieu-ID); only --status reads it
  --status        report what became of that branch and stop. Runs git in the
                  project's checkout and no assistant anywhere
  --dry-run       say what would be done, and do none of it
  --no-check      skip the check that every path in repos.local is a checkout
  --no-postm      let the agent decide whether this run earned a
                  docs/postmortem.md entry -- the rule in docs/postmortem.md.
                  By default an entry is written whatever it concludes
  --print         run non-interactively and print the result
  --show-prompt   print the prompt and exit, running nothing
USAGE
  local n; n=$(repos_entries)
  echo "" >&2
  if [ "$n" -eq 0 ]; then
    echo "repo ids would come from $REPOS_FILE," >&2
    echo "which has no entries yet -- until it does, an id is resolved by looking" >&2
    echo "under ${ANOIEU_REPOS:-$HOME} for a directory of that name." >&2
  else
    echo "repo ids come from $REPOS_FILE" >&2
    echo "($n mapped; anything else is looked for under ${ANOIEU_REPOS:-$HOME})" >&2
  fi
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --codex) AGENT=codex; shift ;;
    --claude) AGENT=claude; shift ;;
    --print) PRINT=1; shift ;;
    --show-prompt) SHOW=1; shift ;;
    --dry-run) DRY=1; shift ;;
    --status) STATUS=1; shift ;;
    --no-check) CHECK=0; shift ;;
    --no-postm) POSTM=0; shift ;;
    --branch) BRANCH="${2:-}"; [ -n "$BRANCH" ] || usage; shift 2 ;;
    -h|--help) usage ;;
    -*) echo "process_anoieu: unknown option $1" >&2; usage ;;
    *) if [ -z "$NAME" ]; then NAME="$1"; elif [ -z "$ID" ]; then ID="$1";
       else echo "process_anoieu: too many arguments" >&2; usage; fi; shift ;;
  esac
done
[ -n "$NAME" ] || usage


# -- the synonym, resolved: an explicit path, then the mapping file, then a scan
#    of $ANOIEU_REPOS. An exact directory name wins over a partial one, and an
#    ambiguous partial is an error rather than a guess.
# One entry, as "<id><tab><path>", with ~ expanded. Returns 1 for a blank line
# or a comment. Both the lookup and the check below read the file through this,
# so what the check validates is exactly what the lookup would use.
parse_repos_line() {
  local line="$1" id path
  line="${line#"${line%%[![:space:]]*}"}"
  case "$line" in ''|'#'*) return 1 ;; esac
  id="${line%%[[:space:]]*}"
  path="${line#"$id"}"
  path="${path#"${path%%[![:space:]]*}"}"
  path="${path%"${path##*[![:space:]]}"}"
  case "$path" in "~") path="$HOME" ;; "~/"*) path="$HOME/${path#\~/}" ;; esac
  printf '%s\t%s\n' "$id" "$path"
}

from_repos_file() {
  local want="$1" line parsed id path
  [ -f "$REPOS_FILE" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    parsed=$(parse_repos_line "$line") || continue
    id=${parsed%%$'\t'*}
    path=${parsed#*$'\t'}
    [ "$id" = "$want" ] || continue
    [ -n "$path" ] || continue
    if [ ! -d "$path" ]; then
      echo "process_anoieu: $REPOS_FILE maps '$want' to '$path', which is not a directory" >&2
      return 2
    fi
    (cd "$path" && pwd)
    return 0
  done < "$REPOS_FILE"
  return 1
}

# -- the file, checked. Every run does this: an entry that points nowhere is
#    silent until the day you use it, and the day you use it is the day you
#    wanted to be doing something else. A bad entry for the id you are actually
#    resolving is a hard error above; the rest are reported and the run goes on,
#    because a broken mapping for cvc5 is no reason not to answer logos.
check_repos_file() {
  local line parsed id path lineno=0 seen="" problems=()
  [ -f "$REPOS_FILE" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno + 1))
    parsed=$(parse_repos_line "$line") || continue
    id=${parsed%%$'\t'*}
    path=${parsed#*$'\t'}
    case " $seen " in
      *" $id "*) problems+=("$lineno  $id -- already mapped above; this line is ignored") ;;
      *)
        seen="$seen $id"
        if [ -z "$path" ]; then
          problems+=("$lineno  $id -- no path; an entry is '<repo-id> <path>'")
        elif [ ! -e "$path" ]; then
          problems+=("$lineno  $id  $path -- no such directory")
        elif [ ! -d "$path" ]; then
          problems+=("$lineno  $id  $path -- not a directory")
        elif ! git -C "$path" rev-parse --git-dir >/dev/null 2>&1; then
          problems+=("$lineno  $id  $path -- not a git repository")
        fi
        ;;
    esac
  done < "$REPOS_FILE"
  [ "${#problems[@]}" -gt 0 ] || return 0
  {
    echo ""
    echo "process_anoieu: ${#problems[@]} problem(s) in $REPOS_FILE"
    printf '   line %s\n' "${problems[@]}"
    echo "   Fix them, or pass --no-check to stop looking. Ids that resolve some"
    echo "   other way are unaffected, and this run continues."
    echo ""
  } >&2
  return 1
}

# Prints two lines: how it resolved, then what it resolved to. Returning the
# route in a variable does not work -- resolve runs in a command substitution,
# and a subshell cannot set anything its caller will see, which is why --dry-run
# used to report "a scan" whatever had actually happened.
resolve() {
  local want="$1" roots r d exact=() partial=() mapped rc
  if [ -d "$want" ]; then printf 'a path\n'; (cd "$want" && pwd); return; fi
  mapped=$(from_repos_file "$want"); rc=$?
  [ "$rc" = 2 ] && return 1
  if [ "$rc" = 0 ]; then printf '%s\n%s\n' "$REPOS_FILE" "$mapped"; return; fi
  roots="${ANOIEU_REPOS:-$HOME}"
  local IFS=:
  for r in $roots; do
    [ -d "$r" ] || continue
    unset IFS
    for d in "$r"/*/; do
      d="${d%/}"
      case "$(basename "$d")" in
        "$want") exact+=("$d") ;;
        *"$want"*) partial+=("$d") ;;
      esac
    done
    local IFS=:
  done
  unset IFS
  if [ "${#exact[@]}" -gt 0 ]; then
    printf 'a scan of %s\n%s\n' "$roots" "${exact[0]}"; return; fi
  if [ "${#partial[@]}" -eq 1 ]; then
    printf 'a scan of %s\n%s\n' "$roots" "${partial[0]}"; return; fi
  if [ "${#partial[@]}" -gt 1 ]; then
    { echo "process_anoieu: '$want' matches more than one directory:";
      printf '   %s\n' "${partial[@]}";
      echo "   name one of them in $REPOS_FILE, or give a path"; } >&2
    return 1
  fi
  { echo "process_anoieu: nothing called '$want' under ${roots//:/, }";
    echo "   add an entry to $REPOS_FILE, or give a path"; } >&2
  return 1
}
[ "$CHECK" = 1 ] && { check_repos_file || true; }

RESOLUTION=$(resolve "$NAME") || exit 2
RESOLVED_BY=${RESOLUTION%%$'\n'*}
DIR=${RESOLUTION#*$'\n'}
PROJECT=$(basename "$DIR")
: "${BRANCH:=anoieu-${ID:-findings}}"

# -- the reply, if it is there. Bounded to two levels: the file is meant to be
#    at the root, and walking a whole cvc5 checkout to find out otherwise is not
#    a trade worth making.
find_reply() {
  local d="$1"
  if [ -f "$d/anoieu-response.md" ]; then printf '%s\n' "$d/anoieu-response.md"; return 0; fi
  find "$d" -maxdepth 2 -type f -name '*.md' -not -path '*/.git/*' \
    -exec grep -l 'HUMAN RESPONSE:' {} + 2>/dev/null | head -1
}

describe_reply() {
  local reply blocks waiting
  reply=$(find_reply "$1")
  if [ -z "$reply" ]; then
    echo "   reply      none found -- looked for anoieu-response.md, and for"
    echo "              HUMAN RESPONSE: in *.md within two levels"
    return 1
  fi
  blocks=$(grep -c '^## ' "$reply" 2>/dev/null || echo 0)
  waiting=$(grep -c 'HUMAN RESPONSE: *$' "$reply" 2>/dev/null || echo 0)
  echo "   reply      ${reply#$1/}  -- $blocks block(s), $waiting awaiting a human"
  return 0
}

# -- --status: what became of the branch check_anoieu was told to work on. No
#    assistant is involved and nothing is written: this is git, reported.
if [ "$STATUS" = 1 ]; then
  git -C "$DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "process_anoieu: $DIR is not a git repository" >&2; exit 2; }
  CURRENT=$(git -C "$DIR" branch --show-current 2>/dev/null || true)
  echo "-- $PROJECT: $DIR  (from $RESOLVED_BY)"
  echo "   checked out ${CURRENT:-(detached HEAD)}; asking after $BRANCH"

  WHERE=""
  git -C "$DIR" show-ref --verify --quiet "refs/heads/$BRANCH" && WHERE="local"
  git -C "$DIR" show-ref --verify --quiet "refs/remotes/origin/$BRANCH" \
    && WHERE="${WHERE:+$WHERE and }origin"
  if [ -z "$WHERE" ]; then
    echo "   branch     $BRANCH is not here -- nothing has been answered on it,"
    echo "              or it was answered somewhere else"
  else
    REF="$BRANCH"
    git -C "$DIR" show-ref --verify --quiet "refs/heads/$BRANCH" || REF="origin/$BRANCH"
    BASE=$(git -C "$DIR" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
    if [ -z "$BASE" ]; then
      for c in origin/main origin/master main master; do
        git -C "$DIR" rev-parse --verify --quiet "$c" >/dev/null 2>&1 && { BASE="$c"; break; }
      done
    fi
    echo "   branch     $BRANCH ($WHERE)"
    if [ -n "$BASE" ]; then
      AHEAD=$(git -C "$DIR" rev-list --count "$BASE..$REF" 2>/dev/null || echo "?")
      if git -C "$DIR" merge-base --is-ancestor "$REF" "$BASE" 2>/dev/null; then
        echo "              merged into $BASE"
      else
        echo "              $AHEAD commit(s) $BASE does not have"
      fi
      git -C "$DIR" log --oneline --no-decorate -10 "$BASE..$REF" 2>/dev/null \
        | sed 's/^/                /'
    else
      git -C "$DIR" log --oneline --no-decorate -10 "$REF" 2>/dev/null \
        | sed 's/^/                /'
    fi
  fi
  describe_reply "$DIR" || true
  echo "   git status"
  git -C "$DIR" status --short --branch | sed 's/^/                /'
  exit 0
fi

# -- where anoieu is: this script's checkout, or the one we are standing in
looks_like_anoieu() { [ -f "$1/docs/open-findings.md" ] && [ -d "$1/anoieu_fuzz" ]; }
ANOIEU=""
for c in "${ANOIEU_ROOT:-}" "$HERE" "$HERE/.." "$PWD"; do
  if [ -n "$c" ] && looks_like_anoieu "$c"; then ANOIEU=$(cd "$c" && pwd); break; fi
done
[ -n "$ANOIEU" ] || {
  echo "process_anoieu: cannot find the anoieu checkout; set \$ANOIEU_ROOT" >&2; exit 2; }

if [ -n "$ID" ]; then
  SCOPE="Process the block about $ID and only that one; leave any others alone."
else
  SCOPE="Process every block in it, one at a time, leaving the record consistent
after each so that stopping partway is safe. Blocks may share a cause; each
still gets its own answer."
fi

# The one part of the prompt --no-postm changes; both forms are in the document.
if [ "$POSTM" = 1 ]; then
  POSTM='7. Write a postmortem entry for this run, whether or not anything changed.'
else
  POSTM='7. Decide whether this earned a postmortem entry. It did if handling it changed
   how anoieu works -- a check, the harness, the report, a prompt. If nothing
   here changed, say so and write nothing.'
fi

read -r -d '' PROMPT <<PROMPT_END || true
The $PROJECT project has replied to findings we reported. Their checkout:

  $DIR

Find the reply. Most likely anoieu-response.md at that repository's root, but
what identifies it is blocks headed by a finding id carrying TRIAGE: and HUMAN
RESPONSE: fields. If there are none, stop and say so rather than inferring the
outcome from the repository's state.

$SCOPE

TRIAGE: is an assistant's reading, made quickly and on our word. HUMAN RESPONSE:
is a maintainer's decision. Where they differ the decision counts, and a block
carrying only a triage is a proposal rather than a result.

Working in the anoieu repository ($ANOIEU).

docs/reporting-policy.md is the authority on what you may change. The steps:

1. Find the rows the reply names, by id, in docs/open-findings.md and
   docs/closed-findings.md. A row is in scope because the reply names it --
   whoever owns it, closed or not. A reply disputing a verdict names a closed row.
2. Establish what actually happened, which is not what the triage predicted.
   - EO, DOC, TRI: re-check with \`python3 tools/run.py --pinned\`. It re-derives
     open rows only; a disputed closed row you check by reading deps/ yourself.
   - FUZ: re-run with \`python3 -m anoieu_fuzz verify\`, \$ETHOS and \$LOGOS pointed
     at builds. A finding that no longer reproduces is strong evidence -- but
     establish *why*: stopped reproducing for a reason other than the one on the
     row is a bad reproducer, not a fix, and never reproduced against their
     build is a third outcome again.
   - Look at the branch rather than taking it: compare it to its base and read
     what is on it. A branch level with main, or a change left uncommitted, is
     not a fix.
3. Clean up those rows and no others. Closing moves a row from
   docs/open-findings.md to docs/closed-findings.md with a verdict, never
   deleting it; reopening is the same move back, noting what the verdict missed.
4. If our analysis was wrong, fix what produced it rather than the row: narrow
   the check, add a witness under tests/witnesses/, and record the wrong
   assumption in docs/reports.md. A FUZ finding has no check to narrow -- what
   it may have is a reproducer that was an artefact of the harness, or a
   comparison that was never fair. Say which, remove the directory under
   tests/fuzz/, and ask whether the harness should have refused to report it.
5. Write what happened in docs/reports.md under the log, and update the
   project's section under the register if what we are asking has changed.
6. Read FEEDBACK TO ANOIEU and any OBSERVED, NOT ACTED ON. Act on what concerns
   the report or the tools. What concerns the prompts goes to docs/postmortem.md
   with its evidence and then to me: a person approves every prompt edit, and
   each round leaves them shorter and more procedural, so a proposal that adds
   says what it removes, and technical detail belongs in the docs a prompt links
   to rather than in the prompt.

$POSTM

   Entries go at the top of docs/postmortem.md, in the shape that file sets out
   -- short, and only what happened and what the workflow learned; the reasoning
   at length belongs in docs/reports.md. Update "Where the workflow stands" in
   the same file if this round changed what is outstanding.

Leave everything staged and commit nothing -- the diff is the review, and it is
mine to approve. Touch no issue tracker, here or anywhere. Say what you decided
and why: the action you took, not a summary of what you read. Come back to me
only if you disagree with how the reply classified the resolution, or cannot
tell whether the finding is resolved -- leave the row open and say what you
would need to know.
PROMPT_END

if [ "$SHOW" = 1 ]; then printf '%s\n' "$PROMPT"; exit 0; fi

if [ "$AGENT" = codex ]; then
  RUN=$([ "$PRINT" = 1 ] && echo "codex exec" || echo "codex")
else
  RUN=$([ "$PRINT" = 1 ] && echo "claude -p" || echo "claude")
fi

if [ "$DRY" = 1 ]; then
  echo "-- process_anoieu, dry run: nothing below is run"
  echo "   project    $PROJECT"
  echo "   directory  $DIR  (from $RESOLVED_BY)"
  echo "   anoieu     $ANOIEU"
  echo "   scope      ${ID:-every block in the reply}"
  describe_reply "$DIR" || true
  command -v "$AGENT" >/dev/null 2>&1 \
    && echo "   agent      $(command -v "$AGENT")" \
    || echo "   agent      $AGENT is NOT on PATH; the real run would stop here"
  echo "   would run  cd $ANOIEU && $RUN '<the prompt, ${#PROMPT} characters>'"
  echo "              the assistant reads $DIR, and edits docs/ and tests/ here,"
  echo "              leaving everything staged and committing nothing"
  echo "   the prompt is --show-prompt; the branch's state is --status"
  exit 0
fi

command -v "$AGENT" >/dev/null 2>&1 || {
  echo "process_anoieu: $AGENT is not on PATH" >&2; exit 127; }

echo "-- process_anoieu: $PROJECT -> $DIR" >&2
echo "   ${ID:-every reply in that repository}, working in $ANOIEU, via $AGENT" >&2

cd "$ANOIEU"
if [ "$AGENT" = codex ]; then
  if [ "$PRINT" = 1 ]; then exec codex exec "$PROMPT"; else exec codex "$PROMPT"; fi
else
  if [ "$PRINT" = 1 ]; then exec claude -p "$PROMPT"; else exec claude "$PROMPT"; fi
fi
