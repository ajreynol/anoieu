#!/usr/bin/env bash
# check_anoieu -- answer anoieu's findings, from inside the project they are about.
#
# Run it in a checkout of ethos, logos, cvc5, eudaimonia -- whichever project a
# row in anoieu's report names. It starts an assistant with the outbound prompt
# from anoieu's reporting policy, which is the fixed text every project gets:
#
#   check_anoieu                    # sweep: every open row this project owns
#   check_anoieu 147433b3e48ae9d6   # one finding, by its id
#   check_anoieu --codex ethos-8    # ... with codex instead of claude
#
# The canonical prompt is docs/reports/reporting-workflow.md in the anoieu repository,
# under "Prompt one: in the project that owns the finding". The copy below is
# that text with the scope line filled in; if the two disagree, the document is
# the one that is right.
#
# Nothing here touches an issue tracker and nothing is sent anywhere: the
# assistant writes a draft into anoieu-response.md for a maintainer to review.
# It prints the checkout's path, so a pasted transcript carries it.

set -euo pipefail

AGENT=claude
PRINT=0
SHOW=0
BRANCH=""
ID=""

usage() {
  cat >&2 <<'USAGE'
usage: check_anoieu [--codex] [--branch NAME] [--print] [--show-prompt] [ID]

  ID              an anoieu finding id (16 hex digits) or register id (ethos-8).
                  Omitted, the prompt sweeps every open row this project owns.
  --codex         run codex instead of claude
  --branch NAME   the branch to work on (default: anoieu-findings, or anoieu-ID)
  --print         run non-interactively and print the result
  --show-prompt   print the prompt and exit, running nothing
USAGE
  exit 2
}

while [ $# -gt 0 ]; do
  case "$1" in
    --codex) AGENT=codex; shift ;;
    --claude) AGENT=claude; shift ;;
    --branch) BRANCH="${2:-}"; [ -n "$BRANCH" ] || usage; shift 2 ;;
    --print) PRINT=1; shift ;;
    --show-prompt) SHOW=1; shift ;;
    -h|--help) usage ;;
    -*) echo "check_anoieu: unknown option $1" >&2; usage ;;
    *) [ -z "$ID" ] || { echo "check_anoieu: one id at a time" >&2; usage; }
       ID="$1"; shift ;;
  esac
done

# Which project this is. The prompt needs the name only to say whose rows to
# read, so a directory name is good enough and a wrong guess is visible.
if ! ROOT=$(git rev-parse --show-toplevel 2>/dev/null); then
  echo "check_anoieu: not in a git repository -- run this in a checkout of the" >&2
  echo "              project the finding is about" >&2
  exit 2
fi
PROJECT=$(basename "$ROOT")
case "$(git -C "$ROOT" remote get-url origin 2>/dev/null || true)" in
  *ethos*)      PROJECT=ethos ;;
  *logos*)      PROJECT=logos ;;
  *cvc5/cvc5*)  PROJECT=cvc5 ;;
  *eudaimonia*) PROJECT=eudaimonia ;;
esac

if [ -n "$ID" ]; then
  SCOPE="Address $ID."
  : "${BRANCH:=anoieu-$ID}"
else
  SCOPE="Address every row whose owner names $PROJECT, including a shared owner like
\"ethos+logos\". Work from the ids; that file is regenerated and rows move. Rows
may share a cause -- say so, and still rule on each in its own block. Answering
ten rows with one sentence is not doing this."
  : "${BRANCH:=anoieu-findings}"
fi

read -r -d '' PROMPT <<PROMPT_END || true
anoieu is a static analyzer for the Eunoia languages. It has reported findings
against this project:

  https://github.com/ajreynol/anoieu/blob/main/docs/reports/open-findings.md

Start there: it says what a row is, and how to confirm one for each code.

$SCOPE

Work on branch $BRANCH, creating it if it is not there. Commit to it locally and
push nothing -- pushing, and any pull request, are the maintainer's. An
uncommitted change is not a fix; the commit is what anoieu reads. Keep
anoieu-response.md out of it: the reply is for us, not for your history.

One row at a time, and only what the rows name:

1. Decide whether it is real -- by reading the file, or by running the
   reproducer -- rather than by trusting the row. Some of what anoieu reports is
   wrong. Say which build you ran.
2. If it is real: make the smallest change that fixes it, and say in one
   sentence what a reader of that file, or a user of that program, would see
   differently.
3. If it is not, or you cannot tell: change nothing and say why. "I cannot tell"
   is the honest answer when you do not know what the file was meant to say.

Fix nothing else you notice; each finding is reported separately. Do not
summarise anoieu's other results: a check that reports nothing is not evidence
that anything is right. Touch no issue tracker -- not ours, not yours, not
anybody's. Everything that reaches a person who did not ask for it is sent by a
person.

Then draft a reply for a maintainer to review and send, in anoieu-response.md at
the repository root, appending and leaving any block already there. One per row:

  ## ID -- <code> -- <what the row names>

  TRIAGE: fixed | not a defect | cannot tell, on branch $BRANCH, pending review.
  <What you changed, or why you changed nothing.>

  OBSERVED, NOT ACTED ON: <optional -- anything true you found and left alone.>

  HUMAN RESPONSE: <leave this empty; the decision is theirs, not yours>

End with two sections. FEEDBACK TO ANOIEU: blunt is useful -- where the time
went and what would have made it fast; what a row should have carried, and
anything here that was unclear or untrue; what else is worth looking for that
anoieu does not do.

Then WHAT THIS NEEDS FROM YOU: name $BRANCH, say nothing is pushed, and say anoieu
sees none of this until they push it and send back where to look. A merge is not
needed to settle a finding; a branch somebody can fetch is. Then list every row
you are declining and ask them to confirm each -- not fixing something is a
decision somebody signs, silence is not a signature, and unconfirmed it is
reported as "cannot tell".
PROMPT_END

if [ "$SHOW" = 1 ]; then printf '%s\n' "$PROMPT"; exit 0; fi

command -v "$AGENT" >/dev/null 2>&1 || {
  echo "check_anoieu: $AGENT is not on PATH" >&2; exit 127; }

echo "-- check_anoieu: $PROJECT ($ROOT)" >&2
echo "   ${ID:-every open row this project owns}, on branch $BRANCH, via $AGENT" >&2

cd "$ROOT"
if [ "$AGENT" = codex ]; then
  if [ "$PRINT" = 1 ]; then exec codex exec "$PROMPT"; else exec codex "$PROMPT"; fi
else
  if [ "$PRINT" = 1 ]; then exec claude -p "$PROMPT"; else exec claude "$PROMPT"; fi
fi
