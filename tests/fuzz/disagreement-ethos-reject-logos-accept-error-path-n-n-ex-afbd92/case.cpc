; anoieu-fuzz proof case, seed p19.cpc (seed:p19.cpc)
(
(declare-const a Bool)
(define @t1 () (and a true))
(define @t2 () (= @t1 a))
(define @t3 () (not @t2))
(define @t4 () (= a @t1))
(assume @p1 @t3)
(step @p2 :rule evaluate :args ((not true)))
(step @p3 :rule eq-refl :args (a))
(step @p4 :rule aci_norm :args (@t4))
(step @p5 :rule symm :premises (@p4))
(step @p6 :rule refl :args (a))
(step @p7 :rule cong :premises (@p6 @p5) :args (@t4))
(step @p8 :rule trans :premises (@p7 @p3))
(step @p9 :rule symm :premises (@p4))
(step @p10 :rule cong :premises (@p9 @p4) :args (@t2))
(step @p11 :rule trans :premises (@p10 @p8))
(step @p12 :rule cong :premises (@p11) :args (@t3))
(step @p13 :rule trans :premises (@p12 @p2))
(step @p14 false :rule eq_resolve :premises (@p1 @p13))
)
