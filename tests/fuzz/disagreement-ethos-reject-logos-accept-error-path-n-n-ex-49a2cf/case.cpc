; anoieu-fuzz proof case, seed /home/andrew-reynolds/logos/test/regress/sexp/test-define.cpc (seed:test-define.cpc)
(declare-sort U 0)
(declare-fun f (U U) U)
(declare-const a U)
(declare-const b U)
(define swap ((x U) (y U)) (f y x))
(define fba () (f b a))
(assume @p0 (not (= (swap a b) fba)))
(step @p1 :rule refl :args (fba))
(step @p2 :rule contra :premises (@p1 @p0))
